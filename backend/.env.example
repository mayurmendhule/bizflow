# Backend Configuration

# MongoDB Connection String
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
DATABASE=mongodb+srv://username:password@cluster.mongodb.net/bizflow

# JWT Secret for authentication
# Use a strong random string in production
JWT_SECRET=your-secure-jwt-secret-key

# Application Environment
NODE_ENV=development

# API Server Port (Render will override this)
PORT=8888

# API Base URL for frontend
PUBLIC_SERVER_FILE=http://localhost:8888/

# OpenAI API Key (optional)
OPENAI_API_KEY=your-openai-api-key

# Resend API Key (optional, for email)
RESEND_API=your-resend-api-key
